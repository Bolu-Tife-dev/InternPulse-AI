DATABASE_URL="file:./internpulse.db"

# ---- AI (Google Gemini free tier) ----
GEMINI_API_KEY=""
# gemini-1.5-flash is the product default; override if the model is unavailable on your key
GEMINI_MODEL="gemini-1.5-flash"

# ---- Job sources ----
# Jooble exposes a free developer API key at https://jooble.org/api (create a "Developer" key)
JOOBLE_API_KEY=""

# Comma separated list of Greenhouse / Lever / Ashby board slugs to crawl directly
# e.g. GREENHOUSE_BOARDS="gitlab,doximity" LEVER_COMPANIES="netflix" ASHBY_BOARDS="stripe,linear"
GREENHOUSE_BOARDS=""
LEVER_COMPANIES=""
ASHBY_BOARDS=""
WORKDAY_TENANTS=""

# ---- SMTP (email auto-apply) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---- Microsoft Graph / Outlook (OAuth 2.0 device code flow) ----
# Azure App registration (public client / mobile & desktop), enable "Allow public client flows",
# add delegated permissions: User.Read, Mail.Read, Mail.Send
MS_CLIENT_ID=""
MS_TENANT_ID="common"
MS_REDIRECT_URI="http://localhost"
MS_SCOPES="User.Read,Mail.Read,Mail.Send"

# ---- Automation ----
# Show the Playwright browser window while filling forms (true/false)
AUTOMATION_HEADLESS="false"
# Milliseconds between automated applications (rate limiting)
APPLY_DELAY_MS="8000"
# How often the Outlook inbox is scanned (ms). 0 disables the scheduler.
OUTLOOK_SYNC_INTERVAL_MS="300000"
