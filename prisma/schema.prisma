// InternPulse AI — local SQLite data model (Prisma ORM)
// NOTE: SQLite connector does not support enums or Json — those are stored as strings.

generator client {
  provider = "prisma-client-js"
  // Custom output outside node_modules so electron-builder reliably
  // packages the generated client (node_modules/.prisma is a phantom
  // dependency and gets pruned from the asar).
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CandidateProfile {
  id                String   @id @default(cuid())
  fullName          String?
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  location          String?
  timezone          String?
  isNigerianCitizen Boolean  @default(true)
  workAuthorization String   @default("Remote contractor worldwide")
  yearsOfExperience Float    @default(0)
  headline          String?
  summary           String?
  skillsJson        String   @default("[]")
  projectsJson      String   @default("[]")
  languagesJson     String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents Document[]
}

model Document {
  id             String   @id @default(cuid())
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind           String // RESUME | COVER_LETTER
  filename       String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  extractedText  String   @default("")
  parseStatus    String   @default("PENDING") // PENDING | PARSED | FAILED
  parseError     String?
  checksum       String?
  createdAt      DateTime @default(now())

  @@index([profileId, kind])
}

model Job {
  id                  String    @id @default(cuid())
  source              String // jobicy | remotive | jooble | greenhouse | lever | ashby | workday | custom
  sourceId            String
  externalId          String?
  company             String
  title               String
  url                 String
  applyUrl            String?
  applyEmail          String?
  atsType             String? // GREENHOUSE | LEVER | ASHBY | BAMBOOHR | WORKDAY | UNKNOWN | EMAIL
  description         String    @default("")
  descriptionHtml     String    @default("")
  salary              String?
  salaryCurrency      String?
  location            String?
  remotePolicy        String    @default("REMOTE") // REMOTE | HYBRID | ONSITE
  regionEligibility   String    @default("UNKNOWN") // WORLDWIDE | AFRICA_EMEA | NIGERIA_EXPLICIT | RESTRICTED | UNKNOWN
  regionConfidence    Float     @default(0)
  regionNotes         String    @default("[]")
  roleType            String    @default("UNKNOWN") // INTERNSHIP | GRADUATE | JUNIOR | UNKNOWN
  domain              String    @default("UNKNOWN") // FRONTEND | FULLSTACK | BACKEND | SOFTWARE | WEB | UNKNOWN
  techTags            String    @default("[]")
  matchedScore        Float     @default(0)
  status              String    @default("ACTIVE") // ACTIVE | HIDDEN | DELETED
  isApproved          Boolean   @default(false)
  approvalNote        String?
  publishedAt         DateTime?
  fetchedAt           DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())

  applications Application[]

  @@unique([source, sourceId])
  @@index([status])
  @@index([company])
}

model Application {
  id               String    @id @default(cuid())
  jobId            String
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  strategy         String // FORM | EMAIL
  status           String    @default("APPLIED") // APPLIED | SCREENING | INTERVIEW | OFFER | REJECTED | WITHDRAWN | FAILED
  statusDetail     String?
  coverLetter      String?
  answersJson      String    @default("{}")
  confirmationRef  String?
  screenshotPath   String?
  errorMessage     String?
  costEstimate     Float     @default(0)
  createdAt        DateTime  @default(now())
  submittedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  emails EmailMessage[]

  @@index([status])
  @@index([createdAt])
}

model EmailMessage {
  id             String      @id @default(cuid())
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  graphId        String      @unique
  threadId       String?
  subject        String      @default("")
  sender         String      @default("")
  bodyPreview     String      @default("")
  receivedAt     DateTime
  classification String      @default("UNCLASSIFIED") // ACK | ASSESSMENT | INTERVIEW | REJECTION | OFFER | UNCLASSIFIED
  sentiment      String      @default("NEUTRAL") // POSITIVE | NEUTRAL | NEGATIVE
  confidence     Float       @default(0)
  matchedJobId   String?
  rawJson        String      @default("{}")
  syncedAt       DateTime    @default(now())

  @@index([classification])
  @@index([receivedAt])
}

model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model SyncRun {
  id        String   @id @default(cuid())
  kind      String // JOBS | OUTLOOK
  status    String  @default("RUNNING") // RUNNING | SUCCESS | FAILED
  detail    String  @default("")
  found     Int     @default(0)
  created   Int     @default(0)
  startedAt DateTime @default(now())
  endedAt   DateTime?
}
